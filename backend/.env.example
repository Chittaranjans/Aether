# Storage backend: "local" | "gcs" | "supabase"
STORAGE_BACKEND=local

# Local storage directory (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_DIR=./data/weather

# Google Cloud Storage (used when STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=your-weather-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Supabase Storage (used when STORAGE_BACKEND=supabase)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional (frontend/browser only — not required by backend storage)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_BUCKET=weather-archives

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo archive API base URL
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
