# Storage backend: "local" (default, no cloud needed) or "gcs"
STORAGE_BACKEND=local

# Local storage directory (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_DIR=./data/weather

# Google Cloud Storage (used when STORAGE_BACKEND=gcs)
# Free-tier: create a GCS bucket in a GCP project, then either:
# 1) Set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path, or
# 2) Run `gcloud auth application-default login`
GCS_BUCKET_NAME=your-weather-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo archive API base URL
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
